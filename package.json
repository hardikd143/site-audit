{
  "name": "site-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crawl a website and audit every page for accessibility (axe-core, WAVE), Lighthouse, HTML validity, SEO, links and security headers.",
  "bin": {
    "site-audit": "audit.mjs"
  },
  "scripts": {
    "audit": "node audit.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0"
  }
}
